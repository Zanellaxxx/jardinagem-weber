# Provisionamento do administrador local.
EXPO_PUBLIC_ADMIN_EMAIL=admin@exemplo.com
EXPO_PUBLIC_ADMIN_PASSWORD_HASH=cole_aqui_o_hash_bcrypt_com_os_caracteres_dolar_escapados
EXPO_PUBLIC_ADMIN_NAME=Administrador Weber

# Prestadores adicionais em JSON. Exemplo:
# EXPO_PUBLIC_PROVIDERS_JSON=[{"id":"autonomo-joao","name":"João Jardineiro","type":"individual","active":true}]
EXPO_PUBLIC_PROVIDERS_JSON=[]
# Administradores adicionais, associados por providerId e com hash bcrypt.
EXPO_PUBLIC_PROVIDER_ADMINS_JSON=[]

# Configuração opcional para notificações de novas solicitações.
EXPO_PUBLIC_COMPANY_EMAIL=admin@exemplo.com
# Se as variaveis do EmailJS ficarem vazias, o app envia via FormSubmit.
EXPO_PUBLIC_COMPANY_NAME=Jardinagem Weber
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_RESET_TEMPLATE_ID=

# Endpoint opcional que recebe operações POST em /sync.
EXPO_PUBLIC_SYNC_API_URL=
